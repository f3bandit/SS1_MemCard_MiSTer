// generated by tools/messages.py: controller test, which bit lights each column (0 = none)
function [4:0] btn_bit(input r, input [5:0] col);
	begin
		btn_bit = 0;
		case ({r, col})
			{1'b0, 6'd0}: btn_bit = 5'd5;
			{1'b0, 6'd1}: btn_bit = 5'd5;
			{1'b0, 6'd4}: btn_bit = 5'd7;
